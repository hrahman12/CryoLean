# Source deployments upload only the frontend inputs and canonical client.
# Prebuilt deployments use .vercel/output and do not upload the source tree.
/*
!package.json
!vercel.json
!frontend
!docs
frontend/*
!frontend/src
!frontend/public
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/tailwind.config.js
!frontend/postcss.config.js
docs/*
!docs/codex
docs/codex/*
!docs/codex/cryolean-client.js
