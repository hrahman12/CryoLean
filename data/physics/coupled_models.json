{
  "_comment": "Coupled multiphysics models. Each relation is lhs <= rhs, evaluated EXACTLY by the Lean checker over rationals with dimensional analysis. Templates reference experiment parameters ({op: param}) and capabilities ({op: cap}); '$slot' keys are resolved per configuration by the data layer and every resolution is re-checked by Lean through the 'validity' bounds. Only models with status 'validated' are evaluated; any other status is emitted as an UNSUPPORTED check and can never pass.",
  "models": [
    {
      "id": "joule_heating_vs_cooling_power",
      "name": "Joule heating of the measurement vs cooling power at the operating temperature",
      "coupling": [
        "thermal",
        "electrical"
      ],
      "status": "validated",
      "equation": "I^2 * R <= P_cool(T_doc)   valid when T_doc <= T_op",
      "relations": [
        {
          "lhs": {
            "op": "mul",
            "a": {
              "op": "mul",
              "a": {
                "op": "param",
                "name": "measurement_current"
              },
              "b": {
                "op": "param",
                "name": "measurement_current"
              }
            },
            "b": {
              "op": "param",
              "name": "sample_resistance"
            }
          },
          "rhs": {
            "op": "cap",
            "key": "$cooling",
            "sel": "max"
          }
        }
      ],
      "validity": [
        {
          "a": {
            "op": "cap",
            "key": "$cooling.temperature",
            "sel": "max"
          },
          "b": {
            "op": "param",
            "name": "operating_temperature"
          },
          "meaning": "the cooling power used was documented at or below the operating temperature"
        }
      ],
      "parameters": {
        "measurement_current": {
          "unit_dim": "A",
          "description": "excitation current through the sample",
          "adjustable": "decrease"
        },
        "sample_resistance": {
          "unit_dim": "Ohm",
          "description": "sample resistance at the operating temperature"
        },
        "operating_temperature": {
          "unit_dim": "K",
          "description": "temperature the stage must hold"
        }
      },
      "slots": {
        "cooling": {
          "pattern": "cooling_power.at_*",
          "choose": "highest documented temperature not above operating_temperature"
        }
      },
      "assumptions": [
        "steady state: all dissipated power ends up on the stage whose cooling power is used",
        "cooling capacity does not decrease with temperature above the documented point (supported by pm_006, pm_009 and the catalog's own multi-point data)",
        "only the Joule heating of the sample is counted; wiring, radiation and other loads are not included"
      ],
      "valid_range": "operating temperatures at or above the temperature at which the cooling power is documented",
      "justification_evidence_ids": [
        "pm_001",
        "pm_002",
        "pm_003",
        "pm_006",
        "pm_009"
      ]
    },
    {
      "id": "mxc_wiring_heat_budget",
      "name": "Mixing-chamber wiring heat load (with design margin) vs cooling power",
      "coupling": [
        "thermal",
        "electrical"
      ],
      "status": "validated",
      "equation": "margin * (n_drive*q_drive + n_flux*(q_flux + p_flux_dc) + n_out*q_out) <= P_cool(T_doc)   valid when T_doc <= T_op",
      "relations": [
        {
          "lhs": {
            "op": "mul",
            "a": {
              "op": "param",
              "name": "design_margin"
            },
            "b": {
              "op": "add",
              "a": {
                "op": "add",
                "a": {
                  "op": "mul",
                  "a": {
                    "op": "param",
                    "name": "n_drive_lines"
                  },
                  "b": {
                    "op": "param",
                    "name": "q_drive_line"
                  }
                },
                "b": {
                  "op": "mul",
                  "a": {
                    "op": "param",
                    "name": "n_flux_lines"
                  },
                  "b": {
                    "op": "add",
                    "a": {
                      "op": "param",
                      "name": "q_flux_line"
                    },
                    "b": {
                      "op": "param",
                      "name": "p_flux_dc"
                    }
                  }
                }
              },
              "b": {
                "op": "mul",
                "a": {
                  "op": "param",
                  "name": "n_output_lines"
                },
                "b": {
                  "op": "param",
                  "name": "q_output_line"
                }
              }
            }
          },
          "rhs": {
            "op": "cap",
            "key": "$cooling",
            "sel": "max"
          }
        }
      ],
      "validity": [
        {
          "a": {
            "op": "cap",
            "key": "$cooling.temperature",
            "sel": "max"
          },
          "b": {
            "op": "param",
            "name": "operating_temperature"
          },
          "meaning": "the cooling power used was documented at or below the operating temperature"
        }
      ],
      "parameters": {
        "design_margin": {
          "unit_dim": "1"
        },
        "n_drive_lines": {
          "unit_dim": "1",
          "adjustable": "decrease",
          "integer": true
        },
        "n_flux_lines": {
          "unit_dim": "1",
          "adjustable": "decrease",
          "integer": true
        },
        "n_output_lines": {
          "unit_dim": "1",
          "adjustable": "decrease",
          "integer": true
        },
        "q_drive_line": {
          "unit_dim": "W"
        },
        "q_flux_line": {
          "unit_dim": "W"
        },
        "q_output_line": {
          "unit_dim": "W"
        },
        "p_flux_dc": {
          "unit_dim": "W"
        },
        "operating_temperature": {
          "unit_dim": "K"
        }
      },
      "slots": {
        "cooling": {
          "pattern": "cooling_power.at_*",
          "choose": "highest documented temperature not above operating_temperature"
        }
      },
      "assumptions": [
        "per-line passive loads measured by Krinner et al. on their XLD400 transfer to the candidate refrigerator with the same cable types",
        "measurement uncertainties of the per-line loads are not propagated (central values used)",
        "active drive-line dissipation and TWPA pump lines are not included",
        "cooling capacity does not decrease with temperature above the documented point"
      ],
      "valid_range": "mixing-chamber operating temperatures at or above the documented cooling-power temperature",
      "justification_evidence_ids": [
        "hl_010",
        "hl_011",
        "hl_017",
        "hl_019",
        "hl_029",
        "pm_002",
        "pm_003"
      ]
    },
    {
      "id": "magnet_ramp_time",
      "name": "Target field reachable within the ramp-time budget at the documented maximum charging rate",
      "coupling": [
        "magnetic",
        "time"
      ],
      "status": "validated",
      "equation": "B_target <= (dB/dt)_max * t_budget   valid when B_target <= B_max",
      "relations": [
        {
          "lhs": {
            "op": "param",
            "name": "target_field"
          },
          "rhs": {
            "op": "mul",
            "a": {
              "op": "cap",
              "key": "magnetic_field.ramp_rate.max",
              "sel": "max"
            },
            "b": {
              "op": "param",
              "name": "field_ramp_time_budget"
            }
          }
        }
      ],
      "validity": [
        {
          "a": {
            "op": "param",
            "name": "target_field"
          },
          "b": {
            "op": "cap",
            "key": "magnetic_field.max",
            "sel": "max"
          },
          "meaning": "the target is within the installed magnet's documented range"
        }
      ],
      "parameters": {
        "target_field": {
          "unit_dim": "T",
          "adjustable": "decrease"
        },
        "field_ramp_time_budget": {
          "unit_dim": "s",
          "adjustable": "increase"
        }
      },
      "slots": {},
      "assumptions": [
        "ramp starts from zero field and runs at the documented maximum charging rate the whole way (a lower bound on the real time)",
        "Quantum Design's times to full field are consistent with field / maximum rate (pm_021-pm_025)"
      ],
      "valid_range": "target fields within the documented magnet range",
      "justification_evidence_ids": [
        "pm_021",
        "pm_022",
        "pm_023",
        "pm_025"
      ]
    },
    {
      "id": "cooldown_time_budget",
      "name": "Cooldown time plus run duration fits in the available time",
      "coupling": [
        "time",
        "thermal"
      ],
      "status": "validated",
      "equation": "t_cooldown + t_run <= t_available",
      "relations": [
        {
          "lhs": {
            "op": "add",
            "a": {
              "op": "cap",
              "key": "cooldown_time.max",
              "sel": "min"
            },
            "b": {
              "op": "param",
              "name": "run_duration"
            }
          },
          "rhs": {
            "op": "param",
            "name": "available_time"
          }
        }
      ],
      "validity": [],
      "parameters": {
        "run_duration": {
          "unit_dim": "s",
          "adjustable": "decrease"
        },
        "available_time": {
          "unit_dim": "s",
          "adjustable": "increase"
        }
      },
      "slots": {},
      "assumptions": [
        "cooldown and measurement run sequentially",
        "documented cooldown time applies to the configuration as loaded"
      ],
      "valid_range": "any",
      "justification_evidence_ids": []
    },
    {
      "id": "differential_thermal_contraction",
      "name": "Differential thermal contraction between sample and holder stays within the allowed mismatch",
      "coupling": [
        "thermal",
        "mechanical"
      ],
      "status": "validated",
      "equation": "|L * (eps_sample - eps_holder)| <= delta_allowed   (two relations)",
      "relations": [
        {
          "lhs": {
            "op": "mul",
            "a": {
              "op": "param",
              "name": "sample_length"
            },
            "b": {
              "op": "sub",
              "a": {
                "op": "param",
                "name": "eps_sample"
              },
              "b": {
                "op": "param",
                "name": "eps_holder"
              }
            }
          },
          "rhs": {
            "op": "param",
            "name": "allowed_mismatch"
          }
        },
        {
          "lhs": {
            "op": "mul",
            "a": {
              "op": "param",
              "name": "sample_length"
            },
            "b": {
              "op": "sub",
              "a": {
                "op": "param",
                "name": "eps_holder"
              },
              "b": {
                "op": "param",
                "name": "eps_sample"
              }
            }
          },
          "rhs": {
            "op": "param",
            "name": "allowed_mismatch"
          }
        }
      ],
      "validity": [
        {
          "a": {
            "op": "param",
            "name": "contraction_data_temperature"
          },
          "b": {
            "op": "param",
            "name": "operating_temperature"
          },
          "meaning": "contraction data are for the operating temperature (lower bound)"
        },
        {
          "a": {
            "op": "param",
            "name": "operating_temperature"
          },
          "b": {
            "op": "param",
            "name": "contraction_data_temperature"
          },
          "meaning": "contraction data are for the operating temperature (upper bound)"
        }
      ],
      "parameters": {
        "sample_length": {
          "unit_dim": "m",
          "adjustable": "decrease"
        },
        "eps_sample": {
          "unit_dim": "1",
          "signed": true
        },
        "eps_holder": {
          "unit_dim": "1",
          "signed": true
        },
        "allowed_mismatch": {
          "unit_dim": "m"
        },
        "operating_temperature": {
          "unit_dim": "K"
        },
        "contraction_data_temperature": {
          "unit_dim": "K"
        }
      },
      "slots": {},
      "assumptions": [
        "linear (one-dimensional) mismatch along the sample length",
        "materials table values at exactly the operating temperature",
        "no slip, adhesive compliance or stress relaxation modelled"
      ],
      "valid_range": "operating temperature equal to a tabulated contraction temperature (4 K or 80 K)",
      "justification_evidence_ids": [
        "tc_057",
        "tc_058",
        "tc_059"
      ]
    },
    {
