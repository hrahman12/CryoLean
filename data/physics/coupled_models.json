      ]
    },
    {
      "id": "optical_na_vs_f_number",
      "name": "Objective numerical aperture fits through the cryostat's optical cone (f-number)",
      "coupling": [
        "mechanical",
        "optical"
      ],
      "status": "validated",
      "equation": "NA^2 * (4 N^2 + 1) <= 1   (equivalent to NA <= sin(atan(1/(2N))) for NA, N >= 0, n = 1)",
      "relations": [
        {
          "lhs": {
            "op": "mul",
            "a": {
              "op": "mul",
              "a": {
                "op": "param",
                "name": "objective_na"
              },
              "b": {
                "op": "param",
                "name": "objective_na"
              }
            },
            "b": {
              "op": "add",
              "a": {
                "op": "mul",
                "a": {
                  "op": "lit",
                  "value": "4",
                  "unit": "1"
                },
                "b": {
                  "op": "mul",
                  "a": {
                    "op": "cap",
                    "key": "optical.f_number",
                    "sel": "min"
                  },
                  "b": {
                    "op": "cap",
                    "key": "optical.f_number",
                    "sel": "min"
                  }
                }
              },
              "b": {
                "op": "lit",
                "value": "1",
                "unit": "1"
              }
            }
          },
          "rhs": {
            "op": "lit",
            "value": "1",
            "unit": "1"
          }
        }
      ],
      "validity": [
        {
          "a": {
            "op": "lit",
            "value": "0",
            "unit": "1"
          },
          "b": {
            "op": "param",
            "name": "objective_na"
          },
          "meaning": "NA is non-negative"
        },
        {
          "a": {
            "op": "param",
            "name": "objective_na"
          },
          "b": {
            "op": "lit",
            "value": "1",
            "unit": "1"
          },
          "meaning": "dry objective in air (n = 1)"
        }
      ],
      "parameters": {
        "objective_na": {
          "unit_dim": "1",
          "adjustable": "decrease"
        }
      },
      "slots": {},
      "assumptions": [
        "air between objective and window (n = 1)",
        "thin-lens relation tan(theta) = 1/(2N) for the cryostat's optical cone",
        "no vignetting by other apertures"
      ],
      "valid_range": "0 <= NA <= 1",
      "justification_evidence_ids": [
        "pm_011",
        "pm_012",
        "pm_013",
        "pm_014"
      ]
    },
    {
