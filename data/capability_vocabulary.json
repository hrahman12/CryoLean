{
  "_comment": "Universal, extensible capability vocabulary (v2). Keys are data, not Lean code. Values are integers in the canonical unit named here; the data layer converts them exactly to SI rationals with dimensions for Lean. 'better' says which direction is favourable. 'min'-shaped keys are bounds where lower is better.",
  "units": {
    "mK": {
      "description": "millikelvin",
      "si": "K",
      "scale": 1000
    },
    "mT": {
      "description": "millitesla",
      "si": "T",
      "scale": 1000
    },
    "um": {
      "description": "micrometre",
      "si": "m",
      "scale": 1000000
    },
    "nW": {
      "description": "nanowatt",
      "si": "W",
      "scale": 1000000000
    },
    "uPa": {
      "description": "micropascal",
      "si": "Pa",
      "scale": 1000000
    },
    "kHz": {
      "description": "kilohertz",
      "si": "Hz",
      "scale": 0.001
    },
    "s": {
      "description": "second",
      "si": "s",
      "scale": 1
    },
    "mK_per_min": {
      "description": "millikelvin per minute",
      "si": "K/min",
      "scale": 1000
    },
    "pA": {
      "description": "picoampere",
      "si": "A",
      "scale": 1000000000000
    },
    "uOhm": {
      "description": "micro-ohm",
      "si": "Ohm",
      "scale": 1000000
    },
    "nm": {
      "description": "nanometre",
      "si": "m",
      "scale": 1000000000
    },
    "mdeg": {
      "description": "millidegree (angle)",
      "si": "deg",
      "scale": 1000
    },
    "ug": {
      "description": "microgram",
      "si": "g",
      "scale": 1000000
    },
    "count": {
      "description": "dimensionless count",
      "si": "",
      "scale": 1
    },
    "VA": {
      "description": "volt-ampere (apparent power)",
      "si": "W",
      "scale": 1
    }
  },
