{
  "_comment": "Universal, extensible capability vocabulary. Keys are data, not Lean code. Every quantity is stored as an INTEGER in the canonical unit named here; the Lean checker compares units by exact string match and never converts. New keys may be registered (status 'proposed') via the API or by editing this file; a key only becomes 'established' after review. Shape: range | max | min | flag | count.",
  "units": {
    "mK": {
      "description": "millikelvin",
      "si": "K",
      "scale": 1000
    },
    "mT": {
      "description": "millitesla",
      "si": "T",
      "scale": 1000
    },
    "um": {
      "description": "micrometre",
      "si": "m",
      "scale": 1000000
    },
    "nW": {
      "description": "nanowatt",
      "si": "W",
      "scale": 1000000000
    },
    "uPa": {
      "description": "micropascal",
      "si": "Pa",
      "scale": 1000000
    },
    "kHz": {
      "description": "kilohertz",
      "si": "Hz",
      "scale": 0.001
    },
    "s": {
      "description": "second",
      "si": "s",
      "scale": 1
    },
    "mK_per_min": {
      "description": "millikelvin per minute",
      "si": "K/min",
      "scale": 1000
    },
    "pA": {
      "description": "picoampere",
      "si": "A",
      "scale": 1000000000000
    },
    "uOhm": {
      "description": "micro-ohm",
      "si": "Ohm",
      "scale": 1000000
    },
    "nm": {
      "description": "nanometre",
      "si": "m",
      "scale": 1000000000
    },
    "mdeg": {
      "description": "millidegree (angle)",
      "si": "deg",
      "scale": 1000
    },
    "ug": {
      "description": "microgram",
      "si": "g",
      "scale": 1000000
    },
    "count": {
      "description": "dimensionless count",
      "si": "",
      "scale": 1
    }
  },
