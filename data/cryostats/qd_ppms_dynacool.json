  "proposed_vocabulary": [
    {
      "key": "system_startup_time.max",
      "shape": "max",
      "unit": "s",
      "description": "Documented time for full system startup / initial cool-down from room temperature (distinct from cooldown_time.max, which here records sample cool-down 300 K to 1.9 K)",
      "status": "proposed"
    },
    {
      "key": "magnetic_field.ramp_rate.max",
      "shape": "max",
      "unit": "uT_per_s",
      "description": "Maximum documented magnetic-field charging rate (unit uT_per_s proposed: microtesla per second, si T/s, scale 1000000)",
      "status": "proposed"
    },
    {
      "key": "magnetic_field.uniformity",
      "shape": "max",
      "unit": "ppm",
      "description": "Documented field homogeneity (± relative, in ppm) over a stated axial length; the length would need a companion key (magnetic_field.uniformity.length, um)",
      "status": "proposed"
    },
    {
      "key": "temperature.stability.relative",
      "shape": "max",
      "unit": "ppm",
      "description": "Documented temperature stability expressed as ± relative value (ppm of T); manufacturer states stability as a percentage, so the mK value in temperature.stability is a derived worst case",
      "status": "proposed"
    }
  ],
