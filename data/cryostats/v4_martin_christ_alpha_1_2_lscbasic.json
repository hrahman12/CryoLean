 "unknowns": [
  {
   "configuration_id": "martin_christ_alpha_1_2_lscbasic_three_shelves",
   "key": "temperature.range",
   "why": "The quote exists on p. 88, but it describes the product temperature during freezing inside the ice-condenser chamber. This configuration dries outside that chamber (double-chamber method; product page: 'Method Double-chamber', 'Shelf temperature Unheated'). The manual glossary says that without active shelf cooling 'the samples need to be pre-frozen externally', and the brief shelf-drying instructions say 'Freeze the sample separately'. The value also does not apply to this configuration and is only approximate."
  },
  {
   "configuration_id": "martin_christ_alpha_1_2_lscbasic_three_shelves",
   "key": "temperature.base",
   "why": "Rejected for the same reason as temperature.range: the -20 °C applies to freezing inside the condenser chamber, not to the unheated external shelves of this configuration."
  },
  {
   "configuration_id": "martin_christ_alpha_1_2_lscbasic_three_shelves",
   "key": "chamber.volume",
   "why": "3.5 L is the ice-condenser chamber volume. Samples in this configuration sit in the separate acrylic drying chamber, whose volume is not stated. Recording the condenser volume as the sample chamber volume is a substitution."
  }
 ],
