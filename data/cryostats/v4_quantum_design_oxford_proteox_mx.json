 "unknowns": [
  {
   "configuration_id": "quantum_design_oxford_proteox_mx450_14t_bottom_loader",
   "key": "electrical.coax_lines",
   "why": "Bottom-loader options are '60 mm, 96 DC, 22 coax / 72 mm, 96 DC, 28 coax / Dependent on magnet selection'. Solenoid bores run 77-150 mm across 1-14 T, and the magnet table only says 'Up to 14 T ... Puck Dia. Up to 72'. Nothing documents that the 14 T solenoid takes the 72 mm, 28-coax puck. The 14 T + 72 mm configuration is undocumented, so 28 is not supported. At best it is 22 with the 60 mm puck, and that fit is unconfirmed too."
  },
  {
   "configuration_id": "quantum_design_oxford_proteox_mx450_14t_bottom_loader",
   "key": "sample.diameter.max",
   "why": "72 mm is the puck diameter, not the largest sample, and the 14 T + 72 mm puck pairing is 'Dependent on magnet selection' and undocumented. This matches the known gap: no documented puck sample limit, so it should stay unknown."
  }
 ],
