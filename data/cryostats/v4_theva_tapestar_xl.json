 "unknowns": [
  {
   "configuration_id": "theva_tapestar_xl_standard",
   "key": "sample.height.max",
   "why": "'Max. core width 20 mm' is the reel's axial width. The vocabulary defines sample.height.max as 'Maximum sample height / thickness', and the same table gives the tape limit 'Max. thickness | 200 µm'. Using 20 mm overstates the specimen thickness the machine admits by about 100×. Use 200 µm."
  },
  {
   "configuration_id": "theva_tapestar_xl_hf",
   "key": "sample.height.max",
   "why": "Same problem as XL: 20 mm is the reel core width. The specimen thickness limit is 'Max. thickness 200 µm', and the vocabulary key means height/thickness. Use 200 µm."
  }
 ],
