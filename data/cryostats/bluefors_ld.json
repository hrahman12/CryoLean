  "unknowns": [
    {
      "key": "sample.bore_diameter",
      "note": "Experimental space / sample bore below the 294 mm mixing chamber flange is not documented for the frame LD; only the Ultra-Compact variant states 237 mm / 510 mm height (ev_bf_0019, ev_bf_0020). Optional Fast Sample Exchange inserts are 48/58/78 mm (ev_bf_0053) but FSE is not available for LD450sl."
    },
    {
      "key": "magnetic_field.max",
      "note": "Solenoids to 16 T and vector magnets to 9 T are offered for Bluefors systems in general, but no page states which fields fit the LD; the only LD-based documented magnet is a 1-1-1 T vector magnet on a preconfigured Ultra-Compact LD350 (ev_bf_0040)."
    },
    {
      "key": "electrical.dc_lines",
      "note": "DC twisted-pair wiring is optional, sold in sets of 24 wires, max 4 sets per KF40 port; total per system not stated. High-Density Wiring lines (168 per side-loading port) are coaxial, not DC."
    },
    {
      "key": "electrical.coax_lines",
      "note": "Standard LD (ISO-K63 ports) has no documented coaxial line count; only per-port feedthrough-hole counts. HDW (168/port) and Cri/oFlex (256/port, 512 total) require the side-loading sl variant."
    },
    {
      "key": "module.magnetic_shielding",
      "note": "A 'Magnetic Shielding' option page is linked from the LD page but was not fetched; QCage sample holder option includes its own mu-metal + superconducting Al shielding (ev_bf_0052)."
    },
    {
      "key": "temperature.range",
      "note": "Upper temperature for the current LD450 is not stated on bluefors.com; the 2022 manual gives 7 mK to 4.2 K for LD250/LD400."
    },
    {
      "key": "cooling_power.at_4200mK",
      "note": "Available 4K-flange power at 4.2 K with the default PT415 is not stated; PT415 cold head is rated 1.5 W @ 4.2 K (ev_bf_0024); Enhanced Cooling gives ~500 mW at 3 K or ~1500 mW at 5 K (ev_bf_0023)."
    },
    {
      "key": "pressure.base",
      "note": "Only a typical, gauge-dependent vacuum-can pressure of 1-5E-6 mbar for an LD400 is given (ev_bf_0050); no guaranteed value."
    },
    {
      "key": "cooldown_time.max",
      "note": "The 24 h figure is from the current bluefors.com page for LD350/LD450; the 2022 manual gives phase timings (10-12 h precool, Still at 15 K after ~18 h) but no explicit time-to-base."
    },
    {
      "key": "facility",
      "note": "Whole-system cooling-water flow and compressed-air requirements are in the sales-only Pre-Installation Guide; only compressor-level figures were found (PT415/CPA1110: 10.7 kW, 3 GPM; PT310-RM/CPA1114: 13.0 kW, 3.6 GPM)."
    }
  ],
