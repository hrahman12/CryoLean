 "unknowns": [
  {
   "configuration_id": "attocube_attodry2100_9t_attocfm1",
   "key": "vacuum.available",
   "why": "The sample runs in 'He exchange gas', but the datasheet lists an optional 'pumping kit turbomolecular pump with suitable backing pump for sample space preparation', so the sample space can be evacuated. The repo convention (PPMS, TeslatronPT) would be flag true / optional_not_installed, or at least not an installed 'false'."
  },
  {
   "configuration_id": "attocube_attodry2100_9t_attocfm1",
   "key": "pressure.base",
   "why": "No base pressure is specified, but the sample space is pumped by the optional turbo kit. 'Exchange gas' describes the operating atmosphere; it does not show that no evacuated state exists. This should be unknown, not a documented absence."
  },
  {
   "configuration_id": "attocube_attodry2100_9t_attocfm1",
   "key": "sample.diameter.max",
   "why": "'sample space Ø 49 mm for components with circular segments ... Ø 48 mm for cylindrical components' is the clear diameter of the sample space for inserts and components (a bore), not the largest sample. The attoCFM I insert restricts it further. It should be re-keyed as sample.bore_diameter = 48 mm."
  },
  {
   "configuration_id": "attocube_attodry2100_9t_solenoid",
   "key": "temperature.stability",
   "why": "The datasheet guarantees '< ± 10 mK' only for 1.5 .. 10 K. Stability above 10 K up to 300 K is not specified, so storing an unqualified 10 mK for the whole 1.8-300 K range is not conservative. Store it only with a 1.5-10 K range qualifier."
  },
  {
   "configuration_id": "attocube_attodry2100_9t_basic_insert",
   "key": "sample.height.max",
   "why": "Honest unknown: no height or insert length is given on the spec page."
  }
 ],
