# Lean build output (rebuild with `cd lean && lake build`)
lean/.lake/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Runtime state written by the API (research requests, untrusted candidates, runtime registrations)
data/candidates/
data/research_requests/
data/registry/

# Local environment
.env
.DS_Store
Thumbs.db

# Frontend dependencies, local hosting identity and generated output
/frontend/node_modules/
/frontend/dist/
/frontend/.vercel/
/.vercel/
/frontend/.qa/
/frontend/test-results/

# Built locally from the JSON seeds (python -m cryolean build-db)
data/cryolean.db
data/*.db-journal

# Third-party tools fetched by scripts (forensics, Lanyon client)
.tools/

# Lanyon runs (session logs with account ids); the published session is copied to docs/lanyon/
research/lanyon/runs/

# v5 deep-scrape snapshot cache (full page/PDF text, local only; URLs, hashes and short quotes are committed)
research/v5/cache/
.netlify
